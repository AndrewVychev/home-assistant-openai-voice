# Never commit this file after adding real secrets.
OPENAI_API_KEY=sk-proj-replace-me
HA_TOKEN=replace-with-home-assistant-long-lived-access-token

HA_URL=http://homeassistant.local
PORT=3000
HOST=127.0.0.1

# Current low-cost Realtime model. Override if it is unavailable in your project.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin
