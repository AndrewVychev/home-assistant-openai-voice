# Never commit this file after adding real secrets.
GEMINI_API_KEY=replace-with-google-ai-api-key
OPENAI_API_KEY=replace-with-openai-api-key
HA_TOKEN=replace-with-home-assistant-long-lived-access-token

HA_URL=http://homeassistant.local
PORT=3000
HOST=127.0.0.1

# Gemini Developer API Live model. Override if your project exposes another model.
VOICE_PROVIDER=gemini
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Local satellite wake word: micro means Russian «Куза»; openwakeword means «Хей, Джарвис».
HOMEVOICE_WAKE_ENGINE=micro
HOMEVOICE_SATELLITE_ID=local
