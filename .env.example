# Never commit this file after adding real secrets.
GEMINI_API_KEY=replace-with-google-ai-api-key
HA_TOKEN=replace-with-home-assistant-long-lived-access-token

HA_URL=http://homeassistant.local
PORT=3000
HOST=127.0.0.1

# Gemini Developer API Live model. Override if your project exposes another model.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
